# Optional: AI check of announcements. Without it a local rules-based check is used.
OPENROUTER_API_KEY=
# OPENROUTER_URL=
# OPENROUTER_MODEL=

# Storage for posted events (Vercel: add Upstash for Redis from the Storage tab, these are filled in automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 when running behind your own reverse proxy so rate limits see the real visitor IP
# TRUST_PROXY=
